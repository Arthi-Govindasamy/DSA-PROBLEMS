9..................Move All Zeroes to End
class Solution {
    void pushZerosToEnd(int[] arr) {
        // code here
        int n=arr.length;
        int j=0;
        for(int i=0;i<n;i++){
            if(arr[i]!=0){
                arr[j]=arr[i];
                j++;
            }
        }
        for(int i=j;i<n;i++){
            arr[i]=0;
        }
    }
}

10..............Remove Duplicates from Sorted Array
class Solution {
    ArrayList<Integer> removeDuplicates(int[] arr) {
        // code here
        int n=arr.length;
        int j=0;
        for(int i=0;i<n-1;i++){
            if(arr[i]!=arr[i+1]){
               arr[j]=arr[i];
               j++;  
            }
        }
        arr[j]=arr[n-1];
        
        ArrayList<Integer>res=new ArrayList<>();
        for(int i=0;i<=j;i++){
            res.add(arr[i]);
        }
        return res;
    }
}

11..........Move All Negative Elements
class Solution {
    public void segregateElements(int[] arr) {
        // Your code goes here
        List<Integer>pos=new ArrayList<>();
        List<Integer>neg=new ArrayList<>();
        
        for(int num:arr){
            if(num<0){
                neg.add(num);
            }else
                pos.add(num);
        }
        int j=0;
        for(int num:pos){
            arr[j++]=num;
        }
        for(int num:neg){
            arr[j++]=num;
        }
    }
}

12.................Wave Array
class Solution {
    public void sortInWave(int arr[]) {
        // code here
        int n=arr.length;
        for(int i=0;i<=n-2;i=i+2){
            int temp=arr[i];
            arr[i]=arr[i+1];
            arr[i+1]=temp;
        }
    }
}

13..............Count Inversions
class Solution {
    static int inversionCount(int arr[]) {
        // Code Here
        int n=arr.length;
        int count=0;
        
        for(int i=0;i<n-1;i++){
            for(int j=i+1;j<n;j++){
                if(arr[i] > arr[j]){
                count++;
                }
            }
        }
        return count;
        
    }
}

14................Union of Two Array - Brute Force
class Solution {
    static void unionArray(int[]arr, ArrayList<Integer>res){
        for(int i=0;i<arr.length;i++){
            boolean found=false;
            for(int j=0;j<res.size();j++){
                if(arr[i]==res.get(j)){
                    found=true;
                    break;
                }
            }
            if(!found){
                res.add(arr[i]);
            }
        }
    }
    
    public static ArrayList<Integer> findUnion(int[] a, int[] b) {
        // code here
        ArrayList<Integer>res=new ArrayList<>();
        unionArray(a,res);
        unionArray(b,res);
        
        return res;
    }
}

15.............Intersection of Arrays - Brute Force
class Solution {
    public int[] intersection(int[] nums1, int[] nums2) {
        List<Integer>res=new ArrayList<>();
        for(int i=0;i<nums1.length;i++){
            for(int j=0;j<nums2.length;j++){
                if(nums1[i]==nums2[j]){
                    boolean alreadyExists=false;
                    for(int k=0;k<res.size();k++){
                       if(res.get(k)==nums1[i]){
                          alreadyExists=true;
                       }
                    }
                    if(!alreadyExists){
                        res.add(nums1[i]);
                    }
                }
               
            }
        }

        int[]result=new int[res.size()];
        for(int i=0;i<res.size();i++){
            result[i]=res.get(i);
        }
        return result;
    }
}

16............Array duplicates
class Solution {
    public ArrayList<Integer> findDuplicates(int[] arr) {
        // code here
        ArrayList<Integer>res=new ArrayList<>();
        for(int i=0;i<arr.length;i++){ //pick
            //count occurence
            int count=0;
            for(int j=0;j<arr.length;j++){
                if(arr[i]==arr[j]){
                    count++;
                }
    
            }
        
            //condition(atmost one)(check already exists)
            if(count>1){
                boolean found=false;
                for(int k=0;k<res.size();k++){
                    if(res.get(k)==arr[i]){
                        found=true;
                        break;
                    }
                }
                if(!found){
                    res.add(arr[i]);
                }
            }
        }
        return res;
    }
}

17...............Leaders in Array
class Solution {
    static ArrayList<Integer> leaders(int arr[]) {
        
        // code here
        int n=arr.length;
        int max=arr[n-1];
        int[]b=new int[n];
        int j=1;
        b[0]=arr[n-1];
        
        for(int i=n-2;i>=0;i--){
            if(arr[i]>=max){
                max=arr[i];
                b[j]=arr[i];
                j++;
            }
        }
        
        //reverse result into arraylist
        ArrayList<Integer>res=new ArrayList<>();
        for(int i=j-1;i>=0;i--){
            res.add(b[i]);
        }
        return res;
        
    }
}


