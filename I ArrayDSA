4......Rotate Array by One
class Solution {
    public void rotate(int[] arr) {
        // code here
        int i=0;
        int j=arr.length-1;
        
        int last=arr[j];
        while(i<j){
            arr[j]=arr[j-1];
            j--;
        }
        arr[0]=last;
    }
}

5........Rotate Array by k
class Solution {
    public void rotate(int[] a, int k) {
        int n=a.length;
        k=k%n;
        int j=0;
        
        int[] b=new int[n-k];
        for(int i=0;i<n-k;i++){
            b[i]=a[i];
        }
        for(int i=n-k;i<n;i++){
            a[j]=a[i];
            j++;
        }
        for(int i=0;i<b.length;i++){
            a[j]=b[i];
            j++;
        }
    }
}

