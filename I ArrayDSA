1........Second largest element
class Solution {
    public int getSecondLargest(int[] arr) {
        // code here
        int n=arr.length;
        
        int max=-1;
        for(int i=0;i<n;i++){
            if(max<arr[i]){
                max=arr[i];
            }
        }
        
        int max2=-1;
        for(int i=0;i<n;i++){
            if(max2<arr[i]&&arr[i]!=max){
                max2=arr[i];
            }
        }
        return max2;
    }
}

